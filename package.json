{
  "name": "alcode-editor",
  "productName": "Alcode Editor",
  "version": "1.10.0",
  "description": "Alcode Editor — استوديو احترافي لتحرير وتحويل كل صيغ المستندات (PDF, Word, Excel, PowerPoint, EPUB…) لويندوز وماك",
  "author": {
    "name": "Alcode",
    "email": "support@alcode.app"
  },
  "homepage": "https://alcode.app",
  "license": "MIT",
  "main": "./out/main/index.js",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run ocr:assets && npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "postinstall": "electron-builder install-app-deps",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "dist:all": "npm run build && electron-builder --win --mac --publish never",
    "ocr:assets": "node scripts/copy-ocr-assets.mjs"
  },
  "devDependencies": {
    "@cantoo/pdf-lib": "^2.9.1",
    "@expo-google-fonts/amiri": "^0.4.1",
    "@fontsource/amiri": "^5.3.0",
    "@fontsource/noto-naskh-arabic": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@tesseract.js-data/ara": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^5.0.0",
    "bidi-js": "^1.0.3",
    "docx": "^9.7.1",
    "dompurify": "^3.4.14",
    "electron": "^33.4.11",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.1.0",
    "fontkit": "^2.0.4",
    "framer-motion": "^12.0.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.469.0",
    "mammoth": "^1.12.2",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tesseract.js": "^7.0.0",
    "tesseract.js-core": "^7.0.0",
    "turndown": "^7.2.4",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.3"
  }
}
